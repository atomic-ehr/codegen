},"location":{"short":"Where the dispense occurred","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Location"],"index":18},"authorizingPrescription":{"short":"Medication order that authorizes the dispense","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/MedicationRequest"],"array":true,"index":19},"type":{"short":"Trial fill, partial fill, emergency fill, etc.","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://terminology.hl7.org/ValueSet/v3-ActPharmacySupplyType","bindingName":"MedicationDispenseType"},"index":20},"quantity":{"short":"Amount dispensed","type":"Quantity","index":21},"daysSupply":{"short":"Amount of medication expressed as a timing amount","type":"Quantity","index":22},"whenPrepared":{"short":"When product was packaged and reviewed","type":"dateTime","isSummary":true,"index":23},"whenHandedOver":{"short":"When product was given out","type":"dateTime","index":24},"destination":{"short":"Where the medication was sent","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Location"],"index":25},"receiver":{"short":"Who collected the medication","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner"],"array":true,"index":26},"note":{"short":"Information about the dispense","type":"Annotation","array":true,"index":27},"dosageInstruction":{"short":"How the medication is to be used by the patient or administered by the caregiver","type":"Dosage","array":true,"index":28},"substitution":{"short":"Whether a substitution was performed on the dispense","type":"BackboneElement","index":29,"elements":{"wasSubstituted":{"short":"Whether a substitution was or was not performed on the dispense","type":"boolean","index":30},"type":{"short":"Code signifying whether a different drug was dispensed from what was prescribed","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://terminology.hl7.org/ValueSet/v3-ActSubstanceAdminSubstitutionCode","bindingName":"MedicationIntendedSubstitutionType"},"index":31},"reason":{"short":"Why was substitution made","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://terminology.hl7.org/ValueSet/v3-SubstanceAdminSubstitutionReason","bindingName":"MedicationIntendedSubstitutionReason"},"array":true,"index":32},"responsibleParty":{"short":"Who is responsible for the substitution","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole"],"array":true,"index":33}},"required":["wasSubstituted"]},"detectedIssue":{"short":"Clinical issue with action","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/DetectedIssue"],"array":true,"index":34},"eventHistory":{"short":"A list of relevant lifecycle events","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Provenance"],"array":true,"index":35}},"required":["medication","status"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicationKnowledge","type":"MedicationKnowledge","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicationKnowledge","version":"4.0.1","description":"Information about a medication that is used to support knowledge.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"code":{"short":"Code that identifies this medication","type":"CodeableConcept","isSummary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medication-codes","bindingName":"MedicationFormalRepresentation"},"index":0},"status":{"short":"active | inactive | entered-in-error","type":"code","isModifier":true,"isModifierReason":"This element changes the interpretation of all descriptive attributes.","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medicationknowledge-status|4.0.1","bindingName":"MedicationKnowledgeStatus"},"index":1},"manufacturer":{"short":"Manufacturer of the item","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":2},"doseForm":{"short":"powder | tablets | capsule +","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medication-form-codes","bindingName":"MedicationForm"},"index":3},"amount":{"short":"Amount of drug in package","type":"Quantity","isSummary":true,"index":4},"synonym":{"short":"Additional names for a medication","type":"string","isSummary":true,"array":true,"index":5},"relatedMedicationKnowledge":{"short":"Associated or related medication information","type":"BackboneElement","array":true,"index":6,"elements":{"type":{"short":"Category of medicationKnowledge","type":"CodeableConcept","index":7},"reference":{"short":"Associated documentation about the associated medication knowledge","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/MedicationKnowledge"],"array":true,"min":1,"index":8}},"required":["reference","type"]},"associatedMedication":{"short":"A medication resource that is associated with this medication","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Medication"],"array":true,"index":9},"productType":{"short":"Category of the medication or product","type":"CodeableConcept","array":true,"index":10},"monograph":{"short":"Associated documentation about the medication","type":"BackboneElement","array":true,"index":11,"elements":{"type":{"short":"The category of medication document","type":"CodeableConcept","index":12},"source":{"short":"Associated documentation about the medication","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference","http://hl7.org/fhir/StructureDefinition/Media"],"index":13}}},"ingredient":{"short":"Active or inactive ingredient","type":"BackboneElement","array":true,"index":14,"elements":{"item":{"short":"Medication(s) or substance(s) contained in the medication","choices":["itemCodeableConcept","itemReference"],"index":16},"itemCodeableConcept":{"short":"Medication(s) or substance(s) contained in the medication","type":"CodeableConcept","choiceOf":"item","index":17},"itemReference":{"short":"Medication(s) or substance(s) contained in the medication","type":"Reference","choiceOf":"item","refers":["http://hl7.org/fhir/StructureDefinition/Substance"],"index":18},"isActive":{"short":"Active ingredient indicator","type":"boolean","index":19},"strength":{"short":"Quantity of ingredient present","type":"Ratio","index":20}},"required":["item"]},"preparationInstruction":{"short":"The instructions for preparing the medication","type":"markdown","index":21},"intendedRoute":{"short":"The intended or approved route of administration","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/route-codes","bindingName":"MedicationRoute"},"array":true,"index":22},"cost":{"short":"The pricing of the medication","type":"BackboneElement","array":true,"index":23,"elements":{"type":{"short":"The category of the cost information","type":"CodeableConcept","index":24},"source":{"short":"The source or owner for the price information","type":"string","index":25},"cost":{"short":"The price of the medication","type":"Money","index":26}},"required":["cost","type"]},"monitoringProgram":{"short":"Program under which a medication is reviewed","type":"BackboneElement","array":true,"index":27,"elements":{"type":{"short":"Type of program under which the medication is monitored","type":"CodeableConcept","index":28},"name":{"short":"Name of the reviewing program","type":"string","index":29}}},"administrationGuidelines":{"short":"Guidelines for administration of the medication","type":"BackboneElement","array":true,"index":30,"elements":{"dosage":{"short":"Dosage for the medication for the specific guidelines","type":"BackboneElement","array":true,"index":31,"elements":{"type":{"short":"Type of dosage","type":"CodeableConcept","index":32},"dosage":{"short":"Dosage for the medication for the specific guidelines","type":"Dosage","array":true,"min":1,"index":33}},"required":["dosage","type"]},"indication":{"short":"Indication for use that apply to the specific administration guidelines","choices":["indicationCodeableConcept","indicationReference"],"index":35},"indicationCodeableConcept":{"short":"Indication for use that apply to the specific administration guidelines","type":"CodeableConcept","choiceOf":"indication","index":36},"indicationReference":{"short":"Indication for use that apply to the specific administration guidelines","type":"Reference","choiceOf":"indication","refers":["http://hl7.org/fhir/StructureDefinition/ObservationDefinition"],"index":37},"patientCharacteristics":{"short":"Characteristics of the patient that are relevant to the administration guidelines","type":"BackboneElement","array":true,"index":38,"elements":{"characteristic":{"short":"Specific characteristic that is relevant to the administration guideline","choices":["characteristicCodeableConcept","characteristicQuantity"],"index":40},"characteristicCodeableConcept":{"short":"Specific characteristic that is relevant to the administration guideline","type":"CodeableConcept","choiceOf":"characteristic","index":41},"characteristicQuantity":{"short":"Specific characteristic that is relevant to the administration guideline","type":"Quantity","choiceOf":"characteristic","index":42},"value":{"short":"The specific characteristic","type":"string","array":true,"index":43}},"required":["characteristic"]}}},"medicineClassification":{"short":"Categorization of the medication within a formulary or classification system","type":"BackboneElement","array":true,"index":44,"elements":{"type":{"short":"The type of category for the medication (for example, therapeutic classification, therapeutic sub-classification)","type":"CodeableConcept","index":45},"classification":{"short":"Specific category assigned to the medication","type":"CodeableConcept","array":true,"index":46}},"required":["type"]},"packaging":{"short":"Details about packaged medications","type":"BackboneElement","index":47,"elements":{"type":{"short":"A code that defines the specific type of packaging that the medication can be found in","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medicationknowledge-package-type","bindingName":"MedicationPackageType"},"index":48},"quantity":{"short":"The number of product units the package would contain if fully loaded","type":"Quantity","index":49}}},"drugCharacteristic":{"short":"Specifies descriptive properties of the medicine","type":"BackboneElement","array":true,"index":50,"elements":{"type":{"short":"Code specifying the type of characteristic of medication","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medicationknowledge-characteristic","bindingName":"MedicationCharacteristic"},"index":51},"value":{"short":"Description of the characteristic","choices":["valueCodeableConcept","valueString","valueQuantity","valueBase64Binary"],"index":53},"valueCodeableConcept":{"short":"Description of the characteristic","type":"CodeableConcept","choiceOf":"value","index":54},"valueString":{"short":"Description of the characteristic","type":"string","choiceOf":"value","index":55},"valueQuantity":{"short":"Description of the characteristic","type":"Quantity","choiceOf":"value","index":56},"valueBase64Binary":{"short":"Description of the characteristic","type":"base64Binary","choiceOf":"value","index":57}}},"contraindication":{"short":"Potential clinical issue with or between medication(s)","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/DetectedIssue"],"array":true,"index":58},"regulatory":{"short":"Regulatory information about a medication","type":"BackboneElement","array":true,"index":59,"elements":{"regulatoryAuthority":{"short":"Specifies the authority of the regulation","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":60},"substitution":{"short":"Specifies if changes are allowed when dispensing a medication from a regulatory perspective","type":"BackboneElement","array":true,"index":61,"elements":{"type":{"short":"Specifies the type of substitution allowed","type":"CodeableConcept","index":62},"allowed":{"short":"Specifies if regulation allows for changes in the medication when dispensing","type":"boolean","index":63}},"required":["allowed","type"]},"schedule":{"short":"Specifies the schedule of a medication in jurisdiction","type":"BackboneElement","array":true,"index":64,"elements":{"schedule":{"short":"Specifies the specific drug schedule","type":"CodeableConcept","index":65}},"required":["schedule"]},"maxDispense":{"short":"The maximum number of units of the medication that can be dispensed in a period","type":"BackboneElement","index":66,"elements":{"quantity":{"short":"The maximum number of units of the medication that can be dispensed","type":"Quantity","index":67},"period":{"short":"The period that applies to the maximum number of units","type":"Duration","index":68}},"required":["quantity"]}},"required":["regulatoryAuthority"]},"kinetics":{"short":"The time course of drug absorption, distribution, metabolism and excretion of a medication from the body","type":"BackboneElement","array":true,"index":69,"elements":{"areaUnderCurve":{"short":"The drug concentration measured at certain discrete points in time","type":"Quantity","array":true,"index":70},"lethalDose50":{"short":"The median lethal dose of a drug","type":"Quantity","array":true,"index":71},"halfLifePeriod":{"short":"Time required for concentration in the body to decrease by half","type":"Duration","index":72}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicationRequest","type":"MedicationRequest","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicationRequest","version":"4.0.1","description":"An order or request for both supply of the medication and the instructions for administration of the medication to a patient. The resource is called \\"MedicationRequest\\" rather than \\"MedicationPrescription\\" or \\"MedicationOrder\\" to generalize the use across inpatient and outpatient settings, including care plans, etc., and to harmonize with workflow patterns.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"External ids for this request","type":"Identifier","array":true,"index":0},"status":{"short":"active | on-hold | cancelled | completed | entered-in-error | stopped | draft | unknown","type":"code","isModifier":true,"isModifierReason":"This element is labeled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medicationrequest-status|4.0.1","bindingName":"MedicationRequestStatus"},"index":1},"statusReason":{"short":"Reason for current status","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medicationrequest-status-reason","bindingName":"MedicationRequestStatusReason"},"index":2},"intent":{"short":"proposal | plan | order | original-order | reflex-order | filler-order | instance-order | option","type":"code","isModifier":true,"isModifierReason":"This element changes the interpretation of all descriptive attributes. For example \\"the time the request is recommended to occur\\" vs. \\"the time the request is authorized to occur\\" or \\"who is recommended to perform the request\\" vs. \\"who is authorized to perform the request","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medicationrequest-intent|4.0.1","bindingName":"MedicationRequestIntent"},"index":3},"category":{"short":"Type of medication usage","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medicationrequest-category","bindingName":"MedicationRequestCategory"},"array":true,"index":4},"priority":{"short":"routine | urgent | asap | stat","type":"code","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/request-priority|4.0.1","bindingName":"MedicationRequestPriority"},"index":5},"doNotPerform":{"short":"True if request is prohibiting action","type":"boolean","isModifier":true,"isModifierReason":"This element is labeled as a modifier because this element negates the request to occur (ie, this is a request for the medication not to be ordered or prescribed, etc)","isSummary":true,"index":6},"reported":{"short":"Reported rather than primary record","isSummary":true,"choices":["reportedBoolean","reportedReference"],"index":8},"reportedBoolean":{"short":"Reported rather than primary record","type":"boolean","isSummary":true,"choiceOf":"reported","index":9},"reportedReference":{"short":"Reported rather than primary record","type":"Reference","isSummary":true,"choiceOf":"reported","refers":["http://hl7.org/fhir/StructureDefinition/Organization","http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole","http://hl7.org/fhir/StructureDefinition/RelatedPerson"],"index":10},"medication":{"short":"Medication to be taken","isSummary":true,"choices":["medicationCodeableConcept","medicationReference"],"index":12},"medicationCodeableConcept":{"short":"Medication to be taken","type":"CodeableConcept","isSummary":true,"choiceOf":"medication","index":13},"medicationReference":{"short":"Medication to be taken","type":"Reference","isSummary":true,"choiceOf":"medication","refers":["http://hl7.org/fhir/StructureDefinition/Medication"],"index":14},"subject":{"short":"Who or group medication request is for","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Group","http://hl7.org/fhir/StructureDefinition/Patient"],"index":15},"encounter":{"short":"Encounter created as part of encounter/admission/stay","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Encounter"],"index":16},"supportingInformation":{"short":"Information to support ordering of the medication","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Resource"],"array":true,"index":17},"authoredOn":{"short":"When request was initially authored","type":"dateTime","isSummary":true,"index":18},"requester":{"short":"Who/What requested the Request","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Device","http://hl7.org/fhir/StructureDefinition/Organization","http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole","http://hl7.org/fhir/StructureDefinition/RelatedPerson"],"index":19},"performer":{"short":"Intended performer of administration","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/CareTeam","http://hl7.org/fhir/StructureDefinition/Device","http://hl7.org/fhir/StructureDefinition/Organization","http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole","http://hl7.org/fhir/StructureDefinition/RelatedPerson"],"index":20},"performerType":{"short":"Desired kind of performer of the medication administration","type":"CodeableConcept","isSummary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/performer-role","bindingName":"MedicationRequestPerformerType"},"index":21},"recorder":{"short":"Person who entered the request","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole"],"index":22},"reasonCode":{"short":"Reason or indication for ordering or not ordering the medication","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/condition-code","bindingName":"MedicationRequestReason"},"array":true,"index":23},"reasonReference":{"short":"Condition or observation that supports why the prescription is being written","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Condition","http://hl7.org/fhir/StructureDefinition/Observation"],"array":true,"index":24},"instantiatesCanonical":{"short":"Instantiates FHIR protocol or definition","type":"canonical","isSummary":true,"array":true,"index":25},"instantiatesUri":{"short":"Instantiates external protocol or definition","type":"uri","isSummary":true,"array":true,"index":26},"basedOn":{"short":"What request fulfills","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/CarePlan","http://hl7.org/fhir/StructureDefinition/ImmunizationRecommendation","http://hl7.org/fhir/StructureDefinition/MedicationRequest","http://hl7.org/fhir/StructureDefinition/ServiceRequest"],"array":true,"index":27},"groupIdentifier":{"short":"Composite request this is part of","type":"Identifier","isSummary":true,"index":28},"courseOfTherapyType":{"short":"Overall pattern of medication administration","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medicationrequest-course-of-therapy","bindingName":"MedicationRequestCourseOfTherapy"},"index":29},"insurance":{"short":"Associated insurance coverage","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/ClaimResponse","http://hl7.org/fhir/StructureDefinition/Coverage"],"array":true,"index":30},"note":{"short":"Information about the prescription","type":"Annotation","array":true,"index":31},"dosageInstruction":{"short":"How the medication should be taken","type":"Dosage","array":true,"index":32},"dispenseRequest":{"short":"Medication supply authorization","type":"BackboneElement","index":33,"elements":{"initialFill":{"short":"First fill details","type":"BackboneElement","index":34,"elements":{"quantity":{"short":"First fill quantity","type":"Quantity","index":35},"duration":{"short":"First fill duration","type":"Duration","index":36}}},"dispenseInterval":{"short":"Minimum period of time between dispenses","type":"Duration","index":37},"validityPeriod":{"short":"Time period supply is authorized for","type":"Period","index":38},"numberOfRepeatsAllowed":{"short":"Number of refills authorized","type":"unsignedInt","index":39},"quantity":{"short":"Amount of medication to supply per dispense","type":"Quantity","index":40},"expectedSupplyDuration":{"short":"Number of days supply per dispense","type":"Duration","index":41},"performer":{"short":"Intended dispenser","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":42}}},"substitution":{"short":"Any restrictions on medication substitution","type":"BackboneElement","index":43,"elements":{"allowed":{"short":"Whether substitution is allowed or not","choices":["allowedBoolean","allowedCodeableConcept"],"index":45},"allowedBoolean":{"short":"Whether substitution is allowed or not","type":"boolean","choiceOf":"allowed","index":46},"allowedCodeableConcept":{"short":"Whether substitution is allowed or not","type":"CodeableConcept","choiceOf":"allowed","index":47},"reason":{"short":"Why should (not) substitution be made","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://terminology.hl7.org/ValueSet/v3-SubstanceAdminSubstitutionReason","bindingName":"MedicationIntendedSubstitutionReason"},"index":48}},"required":["allowed"]},"priorPrescription":{"short":"An order/prescription that is being replaced","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/MedicationRequest"],"index":49},"detectedIssue":{"short":"Clinical Issue with action","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/DetectedIssue"],"array":true,"index":50},"eventHistory":{"short":"A list of events of interest in the lifecycle","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Provenance"],"array":true,"index":51}},"required":["intent","medication","status","subject"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicationStatement","type":"MedicationStatement","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicationStatement","version":"4.0.1","description":"A record of a medication that is being consumed by a patient.   A MedicationStatement may indicate that the patient may be taking the medication now or has taken the medication in the past or will be taking the medication in the future.  The source of this information can be the patient, significant other (such as a family member or spouse), or a clinician.  A common scenario where this information is captured is during the history taking process during a patient visit or stay.   The medication information may come from sources such as the patient's memory, from a prescription bottle,  or from a list of medications the patient, clinician or other party maintains. \\n\\nThe primary difference between a medication statement and a medication administration is that the medication administration has complete administration information and is based on actual administration information from the person who administered the medication.  A medication statement is often, if not always, less specific.  There is no required date/time when the medication was administered, in fact we only know that a source has reported the patient is taking this medication, where details such as time, quantity, or rate or even medication product may be incomplete or missing or less precise.  As stated earlier, the medication statement information may come from the patient's memory, from a prescription bottle or from a list of medications the patient, clinician or other party maintains.  Medication administration is more formal and is not missing detailed information.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"External identifier","type":"Identifier","isSummary":true,"array":true,"index":0},"basedOn":{"short":"Fulfils plan, proposal or order","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/CarePlan","http://hl7.org/fhir/StructureDefinition/MedicationRequest","http://hl7.org/fhir/StructureDefinition/ServiceRequest"],"array":true,"index":1},"partOf":{"short":"Part of referenced event","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicationAdministration","http://hl7.org/fhir/StructureDefinition/MedicationDispense","http://hl7.org/fhir/StructureDefinition/MedicationStatement","http://hl7.org/fhir/StructureDefinition/Observation","http://hl7.org/fhir/StructureDefinition/Procedure"],"array":true,"index":2},"status":{"short":"active | completed | entered-in-error | intended | stopped | on-hold | unknown | not-taken","type":"code","isModifier":true,"isModifierReason":"This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medication-statement-status|4.0.1","bindingName":"MedicationStatementStatus"},"index":3},"statusReason":{"short":"Reason for current status","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/reason-medication-status-codes","bindingName":"MedicationStatementStatusReason"},"array":true,"index":4},"category":{"short":"Type of medication usage","type":"CodeableConcept","isSummary":true,"binding":{"strength":"preferred","valueSet":"http://hl7.org/fhir/ValueSet/medication-statement-category","bindingName":"MedicationStatementCategory"},"index":5},"medication":{"short":"What medication was taken","isSummary":true,"choices":["medicationCodeableConcept","medicationReference"],"index":7},"medicationCodeableConcept":{"short":"What medication was taken","type":"CodeableConcept","isSummary":true,"choiceOf":"medication","index":8},"medicationReference":{"short":"What medication was taken","type":"Reference","isSummary":true,"choiceOf":"medication","refers":["http://hl7.org/fhir/StructureDefinition/Medication"],"index":9},"subject":{"short":"Who is/was taking  the medication","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Group","http://hl7.org/fhir/StructureDefinition/Patient"],"index":10},"context":{"short":"Encounter / Episode associated with MedicationStatement","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Encounter","http://hl7.org/fhir/StructureDefinition/EpisodeOfCare"],"index":11},"effective":{"short":"The date/time or interval when the medication is/was/will be taken","isSummary":true,"choices":["effectiveDateTime","effectivePeriod"],"index":13},"effectiveDateTime":{"short":"The date/time or interval when the medication is/was/will be taken","type":"dateTime","isSummary":true,"choiceOf":"effective","index":14},"effectivePeriod":{"short":"The date/time or interval when the medication is/was/will be taken","type":"Period","isSummary":true,"choiceOf":"effective","index":15},"dateAsserted":{"short":"When the statement was asserted?","type":"dateTime","isSummary":true,"index":16},"informationSource":{"short":"Person or organization that provided the information about the taking of this medication","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Organization","http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole","http://hl7.org/fhir/StructureDefinition/RelatedPerson"],"index":17},"derivedFrom":{"short":"Additional supporting information","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Resource"],"array":true,"index":18},"reasonCode":{"short":"Reason for why the medication is being/was taken","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/condition-code","bindingName":"MedicationReason"},"array":true,"index":19},"reasonReference":{"short":"Condition or observation that supports why the medication is being/was taken","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Condition","http://hl7.org/fhir/StructureDefinition/DiagnosticReport","http://hl7.org/fhir/StructureDefinition/Observation"],"array":true,"index":20},"note":{"short":"Further information about the statement","type":"Annotation","array":true,"index":21},"dosage":{"short":"Details of how medication is/was taken or should be taken","type":"Dosage","array":true,"index":22}},"required":["medication","status","subject"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProduct","type":"MedicinalProduct","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProduct","version":"4.0.1","description":"Detailed definition of a medicinal product, typically for uses other than direct patient care (e.g. regulatory use).","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Business identifier for this product. Could be an MPID","type":"Identifier","isSummary":true,"array":true,"index":0},"type":{"short":"Regulatory type, e.g. Investigational or Authorized","type":"CodeableConcept","isSummary":true,"index":1},"domain":{"short":"If this medicine applies to human or veterinary uses","type":"Coding","isSummary":true,"index":2},"combinedPharmaceuticalDoseForm":{"short":"The dose form for a single part product, or combined form of a multiple part product","type":"CodeableConcept","isSummary":true,"index":3},"legalStatusOfSupply":{"short":"The legal status of supply of the medicinal product as classified by the regulator","type":"CodeableConcept","isSummary":true,"index":4},"additionalMonitoringIndicator":{"short":"Whether the Medicinal Product is subject to additional monitoring for regulatory reasons","type":"CodeableConcept","isSummary":true,"index":5},"specialMeasures":{"short":"Whether the Medicinal Product is subject to special measures for regulatory reasons","type":"string","isSummary":true,"array":true,"index":6},"paediatricUseIndicator":{"short":"If authorised for use in children","type":"CodeableConcept","isSummary":true,"index":7},"productClassification":{"short":"Allows the product to be classified by various systems","type":"CodeableConcept","isSummary":true,"array":true,"index":8},"marketingStatus":{"short":"Marketing status of the medicinal product, in contrast to marketing authorizaton","type":"MarketingStatus","isSummary":true,"array":true,"index":9},"pharmaceuticalProduct":{"short":"Pharmaceutical aspects of product","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductPharmaceutical"],"array":true,"index":10},"packagedMedicinalProduct":{"short":"Package representation for the product","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductPackaged"],"array":true,"index":11},"attachedDocument":{"short":"Supporting documentation, typically for regulatory submission","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":12},"masterFile":{"short":"A master file for to the medicinal product (e.g. Pharmacovigilance System Master File)","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":13},"contact":{"short":"A product specific contact, person (in a role), or an organization","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization","http://hl7.org/fhir/StructureDefinition/PractitionerRole"],"array":true,"index":14},"clinicalTrial":{"short":"Clinical trials or studies that this product is involved in","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/ResearchStudy"],"array":true,"index":15},"name":{"short":"The product's name, including full name and possibly coded parts","type":"BackboneElement","isSummary":true,"array":true,"min":1,"index":16,"elements":{"productName":{"short":"The full product name","type":"string","isSummary":true,"index":17},"namePart":{"short":"Coding words or phrases of the name","type":"BackboneElement","isSummary":true,"array":true,"index":18,"elements":{"part":{"short":"A fragment of a product name","type":"string","isSummary":true,"index":19},"type":{"short":"Idenifying type for this part of the name (e.g. strength part)","type":"Coding","isSummary":true,"index":20}},"required":["part","type"]},"countryLanguage"