ociated with container","type":"Reference","choiceOf":"additive","refers":["http://hl7.org/fhir/StructureDefinition/Substance"],"index":39}}},"condition":{"short":"State of the specimen","type":"CodeableConcept","isSummary":true,"binding":{"strength":"extensible","valueSet":"http://terminology.hl7.org/ValueSet/v2-0493","bindingName":"SpecimenCondition"},"array":true,"index":40},"note":{"short":"Comments","type":"Annotation","array":true,"index":41}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
