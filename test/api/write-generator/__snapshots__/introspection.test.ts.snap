{"name":"MedicinalProductIndication","type":"MedicinalProductIndication","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductIndication","version":"4.0.1","description":"Indication for the Medicinal Product.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"subject":{"short":"The medication for which this is an indication","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/MedicinalProduct"],"array":true,"index":0},"diseaseSymptomProcedure":{"short":"The disease, symptom or procedure that is the indication for treatment","type":"CodeableConcept","isSummary":true,"index":1},"diseaseStatus":{"short":"The status of the disease or symptom for which the indication applies","type":"CodeableConcept","isSummary":true,"index":2},"comorbidity":{"short":"Comorbidity (concurrent condition) or co-infection as part of the indication","type":"CodeableConcept","isSummary":true,"array":true,"index":3},"intendedEffect":{"short":"The intended effect, aim or strategy to be achieved by the indication","type":"CodeableConcept","isSummary":true,"index":4},"duration":{"short":"Timing or duration information as part of the indication","type":"Quantity","isSummary":true,"index":5},"otherTherapy":{"short":"Information about the use of the medicinal product in relation to other therapies described as part of the indication","type":"BackboneElement","isSummary":true,"array":true,"index":6,"elements":{"therapyRelationshipType":{"short":"The type of relationship between the medicinal product indication or contraindication and another therapy","type":"CodeableConcept","isSummary":true,"index":7},"medication":{"short":"Reference to a specific medication (active substance, medicinal product or class of products) as part of an indication or contraindication","isSummary":true,"choices":["medicationCodeableConcept","medicationReference"],"index":9},"medicationCodeableConcept":{"short":"Reference to a specific medication (active substance, medicinal product or class of products) as part of an indication or contraindication","type":"CodeableConcept","isSummary":true,"choiceOf":"medication","index":10},"medicationReference":{"short":"Reference to a specific medication (active substance, medicinal product or class of products) as part of an indication or contraindication","type":"Reference","isSummary":true,"choiceOf":"medication","refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/MedicinalProduct","http://hl7.org/fhir/StructureDefinition/Substance","http://hl7.org/fhir/StructureDefinition/SubstanceSpecification"],"index":11}},"required":["medication","therapyRelationshipType"]},"undesirableEffect":{"short":"Describe the undesirable effects of the medicinal product","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductUndesirableEffect"],"array":true,"index":12},"population":{"short":"The population group to which this applies","type":"Population","isSummary":true,"array":true,"index":13}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProductIngredient","type":"MedicinalProductIngredient","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductIngredient","version":"4.0.1","description":"An ingredient of a manufactured item or pharmaceutical product.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Identifier for the ingredient","type":"Identifier","isSummary":true,"index":0},"role":{"short":"Ingredient role e.g. Active ingredient, excipient","type":"CodeableConcept","isSummary":true,"index":1},"allergenicIndicator":{"short":"If the ingredient is a known or suspected allergen","type":"boolean","isSummary":true,"index":2},"manufacturer":{"short":"Manufacturer of this Ingredient","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"array":true,"index":3},"specifiedSubstance":{"short":"A specified substance that comprises this ingredient","type":"BackboneElement","isSummary":true,"array":true,"index":4,"elements":{"code":{"short":"The specified substance","type":"CodeableConcept","isSummary":true,"index":5},"group":{"short":"The group of specified substance, e.g. group 1 to 4","type":"CodeableConcept","isSummary":true,"index":6},"confidentiality":{"short":"Confidentiality level of the specified substance as the ingredient","type":"CodeableConcept","isSummary":true,"index":7},"strength":{"short":"Quantity of the substance or specified substance present in the manufactured item or pharmaceutical product","type":"BackboneElement","isSummary":true,"array":true,"index":8,"elements":{"presentation":{"short":"The quantity of substance in the unit of presentation, or in the volume (or mass) of the single pharmaceutical product or manufactured item","type":"Ratio","isSummary":true,"index":9},"presentationLowLimit":{"short":"A lower limit for the quantity of substance in the unit of presentation. For use when there is a range of strengths, this is the lower limit, with the presentation attribute becoming the upper limit","type":"Ratio","isModifier":true,"isModifierReason":"If this is present it implies that the whole strength is expressed as a range, due to uncertainty or variation","isSummary":true,"index":10},"concentration":{"short":"The strength per unitary volume (or mass)","type":"Ratio","isSummary":true,"index":11},"concentrationLowLimit":{"short":"A lower limit for the strength per unitary volume (or mass), for when there is a range. The concentration attribute then becomes the upper limit","type":"Ratio","isModifier":true,"isModifierReason":"If this is present it implies that the whole strength is expressed as a range, due to uncertainty or variation","isSummary":true,"index":12},"measurementPoint":{"short":"For when strength is measured at a particular point or distance","type":"string","isSummary":true,"index":13},"country":{"short":"The country or countries for which the strength range applies","type":"CodeableConcept","isSummary":true,"array":true,"index":14},"referenceStrength":{"short":"Strength expressed in terms of a reference substance","type":"BackboneElement","isSummary":true,"array":true,"index":15,"elements":{"substance":{"short":"Relevant reference substance","type":"CodeableConcept","isSummary":true,"index":16},"strength":{"short":"Strength expressed in terms of a reference substance","type":"Ratio","isSummary":true,"index":17},"strengthLowLimit":{"short":"Strength expressed in terms of a reference substance","type":"Ratio","isSummary":true,"index":18},"measurementPoint":{"short":"For when strength is measured at a particular point or distance","type":"string","isSummary":true,"index":19},"country":{"short":"The country or countries for which the strength range applies","type":"CodeableConcept","isSummary":true,"array":true,"index":20}},"required":["strength"]}},"required":["presentation"]}},"required":["code","group"]},"substance":{"short":"The ingredient substance","type":"BackboneElement","isSummary":true,"index":21,"elements":{"code":{"short":"The ingredient substance","type":"CodeableConcept","isSummary":true,"index":22},"strength":{"short":"Quantity of the substance or specified substance present in the manufactured item or pharmaceutical product","isSummary":true,"elementReference":["http://hl7.org/fhir/StructureDefinition/MedicinalProductIngredient","elements","specifiedSubstance","elements","strength"],"array":true,"index":23}},"required":["code"]}},"required":["role"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProductInteraction","type":"MedicinalProductInteraction","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductInteraction","version":"4.0.1","description":"The interactions of the medicinal product with other medicinal products, or other forms of interactions.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"subject":{"short":"The medication for which this is a described interaction","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/MedicinalProduct","http://hl7.org/fhir/StructureDefinition/Substance"],"array":true,"index":0},"description":{"short":"The interaction described","type":"string","isSummary":true,"index":1},"interactant":{"short":"The specific medication, food or laboratory test that interacts","type":"BackboneElement","isSummary":true,"array":true,"index":2,"elements":{"item":{"short":"The specific medication, food or laboratory test that interacts","isSummary":true,"choices":["itemReference","itemCodeableConcept"],"index":4},"itemReference":{"short":"The specific medication, food or laboratory test that interacts","type":"Reference","isSummary":true,"choiceOf":"item","refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/MedicinalProduct","http://hl7.org/fhir/StructureDefinition/ObservationDefinition","http://hl7.org/fhir/StructureDefinition/Substance"],"index":5},"itemCodeableConcept":{"short":"The specific medication, food or laboratory test that interacts","type":"CodeableConcept","isSummary":true,"choiceOf":"item","index":6}},"required":["item"]},"type":{"short":"The type of the interaction e.g. drug-drug interaction, drug-food interaction, drug-lab test interaction","type":"CodeableConcept","isSummary":true,"index":7},"effect":{"short":"The effect of the interaction, for example \\"reduced