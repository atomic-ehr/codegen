{"name":"MedicinalProductManufactured","type":"MedicinalProductManufactured","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductManufactured","version":"4.0.1","description":"The manufactured item as contained in the packaged medicinal product.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"manufacturedDoseForm":{"short":"Dose form as manufactured and before any transformation into the pharmaceutical product","type":"CodeableConcept","isSummary":true,"index":0},"unitOfPresentation":{"short":"The “real world” units in which the quantity of the manufactured item is described","type":"CodeableConcept","isSummary":true,"index":1},"quantity":{"short":"The quantity or \\"count number\\" of the manufactured item","type":"Quantity","isSummary":true,"index":2},"manufacturer":{"short":"Manufacturer of the item (Note that this should be named \\"manufacturer\\" but it currently causes technical issues)","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"array":true,"index":3},"ingredient":{"short":"Ingredient","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductIngredient"],"array":true,"index":4},"physicalCharacteristics":{"short":"Dimensions, color etc.","type":"ProdCharacteristic","isSummary":true,"index":5},"otherCharacteristics":{"short":"Other codeable characteristics","type":"CodeableConcept","isSummary":true,"array":true,"index":6}},"required":["manufacturedDoseForm","quantity"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProductPackaged","type":"MedicinalProductPackaged","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductPackaged","version":"4.0.1","description":"A medicinal product in a container or package.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Unique identifier","type":"Identifier","isSummary":true,"array":true,"index":0},"subject":{"short":"The product with this is a pack for","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProduct"],"array":true,"index":1},"description":{"short":"Textual description","type":"string","isSummary":true,"index":2},"legalStatusOfSupply":{"short":"The legal status of supply of the medicinal product as classified by the regulator","type":"CodeableConcept","isSummary":true,"index":3},"marketingStatus":{"short":"Marketing information","type":"MarketingStatus","isSummary":true,"array":true,"index":4},"marketingAuthorization":{"short":"Manufacturer of this Package Item","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductAuthorization"],"index":5},"manufacturer":{"short":"Manufacturer of this Package Item","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"array":true,"index":6},"batchIdentifier":{"short":"Batch numbering","type":"BackboneElement","isSummary":true,"array":true,"index":7,"elements":{"outerPackaging":{"short":"A number appearing on the outer packaging of a specific batch","type":"Identifier","isSummary":true,"index":8},"immediatePackaging":{"short":"A number appearing on the immediate packaging (and not the outer packaging)","type":"Identifier","isSummary":true,"index":9}},"required":["outerPackaging"]},"packageItem":{"short":"A packaging item, as a contained for medicine, possibly with other packaging items within","type":"BackboneElem