3,"elements":{"identifier":{"short":"Identifier for the designation, or procedure number","type":"Identifier","isSummary":true,"array":true,"index":34},"type":{"short":"The type of special designation, e.g. orphan drug, minor use","type":"CodeableConcept","isSummary":true,"index":35},"intendedUse":{"short":"The intended use of the product, e.g. prevention, treatment","type":"CodeableConcept","isSummary":true,"index":36},"indication":{"short":"Condition for which the medicinal use applies","isSummary":true,"choices":["indicationCodeableConcept","indicationReference"],"index":38},"indicationCodeableConcept":{"short":"Condition for which the medicinal use applies","type":"CodeableConcept","isSummary":true,"choiceOf":"indication","index":39},"indicationReference":{"short":"Condition for which the medicinal use applies","type":"Reference","isSummary":true,"choiceOf":"indication","refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductIndication"],"index":40},"status":{"short":"For example granted, pending, expired or withdrawn","type":"CodeableConcept","isSummary":true,"index":41},"date":{"short":"Date when the designation was granted","type":"dateTime","isSummary":true,"index":42},"species":{"short":"Animal species for which this applies","type":"CodeableConcept","isSummary":true,"index":43}}}},"required":["name"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProductAuthorization","type":"MedicinalProductAuthorization","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductAuthorization","version":"4.0.1","description":"The regulatory authorization of a medicinal product.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Business identifier for the marketing authorization, as assigned by a regulator","type":"Identifier","isSummary":true,"array":true,"index":0},"subject":{"short":"The medicinal product that is being authorized","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProduct","http://hl7.org/fhir/StructureDefinition/MedicinalProductPackaged"],"index":1},"country":{"short":"The country in which the marketing authorization has been granted","type":"CodeableConcept","isSummary":true,"array":true,"index":2},"jurisdiction":{"short":"Jurisdiction within a country","type":"CodeableConcept","isSummary":true,"array":true,"index":3},"status":{"short":"The status of the marketing authorization","type":"CodeableConcept","isSummary":true,"index":4},"statusDate":{"short":"The date at which the given status has become applicable","type":"dateTime","isSummary":true,"index":5},"restoreDate":{"short":"The date when a suspended the marketing or the marketing authorization of the product is anticipated to be restored","type":"dateTime","isSummary":true,"index":6},"validityPeriod":{"short":"The beginning of the time period in which the marketing authorization is in the specific status shall be specified A complete date consisting of day, month and year shall be specified using the ISO 8601 date format","type":"Period","isSummary":true,"index":7},"dataExclusivityPeriod":{"short":"A period of time after authorization before generic product applicatiosn can be submitted","type":"Period","isSummary":true,"index":8},"dateOfFirstAuthorization":{"short":"The date when the first authorization was granted by a Medicines Regulatory Agency","type":"dateTime","isSummary":true,"index":9},"internationalBirthDate":{"short":"Date of first marketing authorization for a company's new medicinal product in any country in the World","type":"dateTime","isSummary":true,"index":10},"legalBasis":{"short":"The legal framework against which this authorization is granted","type":"CodeableConcept","isSummary":true,"index":11},"jurisdictionalAuthorization":{"short":"Authorization in areas within a country","type":"BackboneElement","isSummary":true,"array":true,"index":12,"elements":{"identifier":{"short":"The assigned number for the marketing authorization","type":"Identifier","isSummary":true,"array":true,"index":13},"country":{"short":"Country of authorization","type":"CodeableConcept","isSummary":true,"index":14},"jurisdiction":{"short":"Jurisdiction within a country","type":"CodeableConcept","isSummary":true,"array":true,"index":15},"legalStatusOfSupply":{"short":"The legal status of supply in a jurisdiction or region","type":"CodeableConcept","isSummary":true,"index":16},"validityPeriod":{"short":"The start and expected end date of the authorization","type":"Period","isSummary":true,"index":17}}},"holder":{"short":"Marketing Authorization Holder","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":18},"regulator":{"short":"Medicines Regulatory Agency","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":19},"procedure":{"short":"The regulatory procedure for granting or amending a marketing authorization","type":"BackboneElement","isSummary":true,"index":20,"elements":{"identifier":{"short":"Identifier for this procedure","type":"Identifier","isSummary":true,"index":21},"type":{"short":"Type of procedure","type":"CodeableConcept","isSummary":true,"index":22},"date":{"short":"Date of procedure","isSummary":true,"choices":["datePeriod","dateDateTime"],"index":24},"datePeriod":{"short":"Date of procedure","type":"Period","isSummary":true,"choiceOf":"date","index":25},"dateDateTime":{"short":"Date of procedure","type":"dateTime","isSummary":true,"choiceOf":"date","index":26},"application":{"short":"Applcations submitted to obtain a marketing authorization","isSummary":true,"elementReference":["http://hl7.org/fhir/StructureDefinition/MedicinalProductAuthorization","elements","procedure"],"array":true,"index":27}},"required":["type"]}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicinalProductContraindication","type":"MedicinalProductContraindication","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicinalProductContraindication","version":"4.0.1","description":"The clinical particulars - indications, contraindications etc. of a medicinal product, including for regulatory purposes.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"subject":{"short":"The medication for which this is an indication","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/MedicinalProduct"],"array":true,"index":0},"disease":{"short":"The disease, symptom or procedure for the contraindication","type":"CodeableConcept","isSummary":true,"index":1},"diseaseStatus":{"short":"The status of the disease or symptom for the contraindication","type":"CodeableConcept","isSummary":true,"index":2},"comorbidity":{"short":"A comorbidity (concurrent condition) or coinfection","type":"CodeableConcept","isSummary":true,"array":true,"index":3},"therapeuticIndication":{"short":"Information about the use of the medicinal product in relation to other therapies as part of the indication","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicinalProductIndication"],"array":true,"index":4},"otherTherapy":{"short":"Information about the use of the medicinal product in relation to other therapies described as part of the indication","type":"BackboneElement","isSummary":true,"array":true,"index":5,"elements":{"therapyRelationshipType":{"short":"The type of relationship between the medicinal product indication or contraindication and another therapy","type":"CodeableConcept","isSummary":true,"index":6},"medication":{"short":"Reference to a specific medication (active substance, medicinal product or class of products) as part of an indication or contraindication","is