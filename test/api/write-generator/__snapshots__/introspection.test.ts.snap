":"CodeableConcept","isSummary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/body-site","bindingName":"BodySite"},"index":16},"deviceName":{"short":"Name of the device/manufacturer","type":"string","isSummary":true,"index":17},"device":{"short":"Observing Device","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Device","http://hl7.org/fhir/StructureDefinition/DeviceMetric"],"index":18},"height":{"short":"Height of the image in pixels (photo/video)","type":"positiveInt","isSummary":true,"index":19},"width":{"short":"Width of the image in pixels (photo/video)","type":"positiveInt","isSummary":true,"index":20},"frames":{"short":"Number of frames if > 1 (photo)","type":"positiveInt","isSummary":true,"index":21},"duration":{"short":"Length in seconds (audio / video)","type":"decimal","isSummary":true,"index":22},"content":{"short":"Actual Media - reference or data","type":"Attachment","isSummary":true,"index":23},"note":{"short":"Comments made about the media","type":"Annotation","array":true,"index":24}},"required":["content","status"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"Medication","type":"Medication","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/Medication","version":"4.0.1","description":"This resource is primarily used for the identification and definition of a medication for the purposes of prescribing, dispensing, and administering a medication as well as for making statements about medication use.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Business identifier for this medication","type":"Identifier","isSummary":true,"array":true,"index":0},"code":{"short":"Codes that identify this medication","type":"CodeableConcept","isSummary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medication-codes","bindingName":"MedicationFormalRepresentation"},"index":1},"status":{"short":"active | inactive | entered-in-error","type":"code","isModifier":true,"isModifierReason":"This element changes the interpretation of all descriptive attributes.","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medication-status|4.0.1","bindingName":"MedicationStatus"},"index":2},"manufacturer":{"short":"Manufacturer of the item","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Organization"],"index":3},"form":{"short":"powder | tablets | capsule +","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/medication-form-codes","bindingName":"MedicationForm"},"index":4},"amount":{"short":"Amount of drug in package","type":"Ratio","isSummary":true,"index":5},"ingredient":{"short":"Active or inactive ingredient","type":"BackboneElement","array":true,"index":6,"elements":{"item":{"short":"The actual ingredient or content","choices":["itemCodeableConcept","itemReference"],"index":8},"itemCodeableConcept":{"short":"The actual ingredient or content","type":"CodeableConcept","choiceOf":"item","index":9},"itemReference":{"short":"The actual ingredient or content","type":"Reference","choiceOf":"item","refers":["http://hl7.org/fhir/StructureDefinition/Medication","http://hl7.org/fhir/StructureDefinition/Substance"],"index":10},"isActive":{"short":"Active ingredient indicator","type":"boolean","index":11},"strength":{"short":"Quantity of ingredient present","type":"Ratio","index":12}},"required":["item"]},"batch":{"short":"Details about packaged medications","type":"BackboneElement","index":13,"elements":{"lotNumber":{"short":"Identifier assigned to batch","type":"string","index":14},"expirationDate":{"short":"When batch will expire","type":"dateTime","index":15}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicationAdministration","type":"MedicationAdministration","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicationAdministration","version":"4.0.1","description":"Describes the event of a patient consuming or otherwise being administered a medication.  This may be as simple as swallowing a tablet or it may be a long running infusion.  Related resources tie this event to the authorizing prescription, and the specific encounter between patient and health care practitioner.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"External identifier","type":"Identifier","array":true,"index":0},"instantiates":{"short":"Instantiates protocol or definition","type":"uri","isSummary":true,"array":true,"index":1},"partOf":{"short":"Part of referenced event","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/MedicationAdministration","http://hl7.org/fhir/StructureDefinition/Procedure"],"array":true,"index":2},"status":{"short":"in-progress | not-done | on-hold | completed | entered-in-error | stopped | unknown","type":"code","isModifier":true,"isModifierReason":"This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medication-admin-status|4.0.1","bindingName":"MedicationAdministrationStatus"},"index":3},"statusReason":{"short":"Reason administration not performed","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/reason-medication-not-given-codes","bindingName":"MedicationAdministrationNegationReason"},"array":true,"index":4},"category":{"short":"Type of medication usage","type":"CodeableConcept","binding":{"strength":"preferred","valueSet":"http://hl7.org/fhir/ValueSet/medication-admin-category","bindingName":"MedicationAdministrationCategory"},"index":5},"medication":{"short":"What was administered","isSummary":true,"choices":["medicationCodeableConcept","medicationReference"],"index":7},"medicationCodeableConcept":{"short":"What was administered","type":"CodeableConcept","isSummary":true,"choiceOf":"medication","index":8},"medicationReference":{"short":"What was administered","type":"Reference","isSummary":true,"choiceOf":"medication","refers":["http://hl7.org/fhir/StructureDefinition/Medication"],"index":9},"subject":{"short":"Who received medication","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Group","http://hl7.org/fhir/StructureDefinition/Patient"],"index":10},"context":{"short":"Encounter or Episode of Care administered as part of","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Encounter","http://hl7.org/fhir/StructureDefinition/EpisodeOfCare"],"index":11},"supportingInformation":{"short":"Additional information to support administration","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Resource"],"array":true,"index":12},"effective":{"short":"Start and end time of administration","isSummary":true,"choices":["effectiveDateTime","effectivePeriod"],"index":14},"effectiveDateTime":{"short":"Start and end time of administration","type":"dateTime","isSummary":true,"choiceOf":"effective","index":15},"effectivePeriod":{"short":"Start and end time of administration","type":"Period","isSummary":true,"choiceOf":"effective","index":16},"performer":{"short":"Who performed the medication administration and what they did","type":"BackboneElement","isSummary":true,"array":true,"index":17,"elements":{"function":{"short":"Type of performance","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/med-admin-perform-function","bindingName":"MedicationAdministrationPerformerFunction"},"index":18},"actor":{"short":"Who performed the medication administration","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/Device","http://hl7.org/fhir/StructureDefinition/Patient","http://hl7.org/fhir/StructureDefinition/Practitioner","http://hl7.org/fhir/StructureDefinition/PractitionerRole","http://hl7.org/fhir/StructureDefinition/RelatedPerson"],"index":19}},"required":["actor"]},"reasonCode":{"short":"Reason administration performed","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/reason-medication-given-codes","bindingName":"MedicationAdministrationReason"},"array":true,"index":20},"reasonReference":{"short":"Condition or observation that supports why the medication was administered","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Condition","http://hl7.org/fhir/StructureDefinition/DiagnosticReport","http://hl7.org/fhir/StructureDefinition/Observation"],"array":true,"index":21},"request":{"short":"Request administration performed against","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/MedicationRequest"],"index":22},"device":{"short":"Device used to administer","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Device"],"array":true,"index":23},"note":{"short":"Information about the administration","type":"Annotation","array":true,"index":24},"dosage":{"short":"Details of how medication was taken","type":"BackboneElement","constraint":{"mad-1":{"expression":"dose.exists() or rate.exists()","human":"SHALL have at least one of dosage.dose or dosage.rate[x]","severity":"error"}},"index":25,"elements":{"text":{"short":"Free text dosage instructions e.g. SIG","type":"string","index":26},"site":{"short":"Body site administered to","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/approach-site-codes","bindingName":"MedicationAdministrationSite"},"index":27},"route":{"short":"Path of substance into body","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/route-codes","bindingName":"RouteOfAdministration"},"index":28},"method":{"short":"How drug was administered","type":"CodeableConcept","binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/administration-method-codes","bindingName":"MedicationAdministrationMethod"},"index":29},"dose":{"short":"Amount of medication per dose","type":"Quantity","index":30},"rate":{"short":"Dose quantity per unit of time","choices":["rateRatio","rateQuantity"],"index":32},"rateRatio":{"short":"Dose quantity per unit of time","type":"Ratio","choiceOf":"rate","index":33},"rateQuantity":{"short":"Dose quantity per unit of time","type":"Quantity","choiceOf":"rate","index":34}}},"eventHistory":{"short":"A list of events of interest in the lifecycle","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Provenance"],"array":true,"index":35}},"required":["effective","medication","status","subject"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"MedicationDispense","type":"MedicationDispense","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/MedicationDispense","version":"4.0.1","description":"Indicates that a medication product is to be or has been dispensed for a named person/patient.  This includes a description of the medication product (supply) provided and the instructions for administering the medication.  The medication dispense is the result of a pharmacy system responding to a medication order.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"External identifier","type":"Identifier","array":true,"index":0},"partOf":{"short":"Event that dispense is part of","type":"Reference","refers":["http://hl7.org/fhir/StructureDefinition/Procedure"],"array":true,"index":1},"status":{"short":"preparation | in-progress | cancelled | on-hold | completed | entered-in-error | stopped | declined | unknown","type":"code","isModifier":true,"isModifierReason":"This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/medicationdispense-status|4.0.1","bindingName":"MedicationDispenseStatus"},"index":2},"statusReason":{"short":"Why a dispense was not performed","choices":["statusReasonCodeableConcept","statusReasonReference"],"index":4},"statusReasonCodeableConcept":{"short":"Why a dispense was not performed","type":"CodeableConcept","choiceOf":"statusReason","index":5},"statusReasonReference":{"short":"Why a dispense was not performed","type":"Reference","choiceOf":"statusReason","refers":["http://hl7.org/fhir/StructureDefinition/DetectedIssue"],"index":6},"category":{"short":"Type of medication dispense","type":"CodeableConcept","binding":{"strength":"preferred","valueSet":"http://hl7.org/fhir/Valu