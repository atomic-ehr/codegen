de","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/map-transform|4.0.1","bindingName":"StructureMapTransform"},"index":103},"parameter":{"short":"Parameters to the transform","type":"BackboneElement","isSummary":true,"array":true,"index":104,"elements":{"value":{"short":"Parameter value - variable or literal","isSummary":true,"choices":["valueId","valueString","valueBoolean","valueInteger","valueDecimal"],"index":106},"valueId":{"short":"Parameter value - variable or literal","type":"id","isSummary":true,"choiceOf":"value","index":107},"valueString":{"short":"Parameter value - variable or literal","type":"string","isSummary":true,"choiceOf":"value","index":108},"valueBoolean":{"short":"Parameter value - variable or literal","type":"boolean","isSummary":true,"choiceOf":"value","index":109},"valueInteger":{"short":"Parameter value - variable or literal","type":"integer","isSummary":true,"choiceOf":"value","index":110},"valueDecimal":{"short":"Parameter value - variable or literal","type":"decimal","isSummary":true,"choiceOf":"value","index":111}},"required":["value"]}}},"rule":{"short":"Rules contained in this rule","isSummary":true,"elementReference":["http://hl7.org/fhir/StructureDefinition/StructureMap","elements","group","elements","rule"],"array":true,"index":112},"dependent":{"short":"Which other rules to apply in the context of this rule","type":"BackboneElement","isSummary":true,"array":true,"index":113,"elements":{"name":{"short":"Name of a rule or group to apply","type":"id","isSummary":true,"index":114},"variable":{"short":"Variable to pass to the rule or group","type":"string","isSummary":true,"array":true,"min":1,"index":115}},"required":["name","variable"]},"documentation":{"short":"Documentation for this instance of data","type":"string","index":116}},"required":["name","source"]}},"required":["input","name","rule","typeMode"]}},"required":["group","name","status","url"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"Subscription","type":"Subscription","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/Subscription","version":"4.0.1","description":"The subscription resource is used to define a push-based subscription from a server to another system. Once a subscription is registered with the server, the server checks every resource that is created or updated, and if the resource matches the given criteria, it sends a message on the defined \\"channel\\" so that another system can take an appropriate action.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"status":{"short":"requested | active | error | off","type":"code","isModifier":true,"isModifierReason":"This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/subscription-status|4.0.1","bindingName":"SubscriptionStatus"},"index":0},"contact":{"short":"Contact details for source (e.g. troubleshooting)","type":"ContactPoint","isSummary":true,"array":true,"index":1},"end":{"short":"When to automatically delete the subscription","type":"instant","isSummary":true,"index":2},"reason":{"short":"Description of why this subscription was created","type":"string","isSummary":true,"index":3},"criteria":{"short":"Rule for server push","type":"string","isSummary":true,"index":4},"error":{"short":"Latest error note","type":"string","isSummary":true,"index":5},"channel":{"short":"The channel on which to report matches to the criteria","type":"BackboneElement","isSummary":true,"index":6,"elements":{"type":{"short":"rest-hook | websocket | email | sms | message","type":"code","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/subscription-channel-type|4.0.1","bindingName":"SubscriptionChannelType"},"index":7},"endpoint":{"short":"Where the channel points to","type":"url","isSummary":true,"index":8},"payload":{"short":"MIME type to send, or omit for no payload","type":"code","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/mimetypes|4.0.1","bindingName":"MimeType"},"index":9},"header":{"short":"Usage depends on the channel type","type":"string","isSummary":true,"array":true,"index":10}},"required":["type"]}},"required":["channel","criteria","reason","status"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"Substance","type":"Substance","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/Substance","version":"4.0.1","description":"A homogeneous material with a definite composition.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Unique identifier","type":"Identifier","isSummary":true,"array":true,"index":0},"status":{"short":"active | inactive | entered-in-error","type":"code","isModifier":true,"isModifierReason":"This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the resource should not be treated as valid","isSummary":true,"binding":{"strength":"required","valueSet":"http://hl7.org/fhir/ValueSet/substance-status|4.0.1","bindingName":"FHIRSubstanceStatus"},"index":1},"category":{"short":"What class/type of substance this is","type":"CodeableConcept","isSummary":true,"binding":{"strength":"extensible","valueSet":"http://hl7.org/fhir/ValueSet/substance-category","bindingName":"SubstanceCategory"},"array":true,"index":2},"code":{"short":"What substance this is","type":"CodeableConcept","isSummary":true,"binding":{"strength":"example","valueSet":"http://hl7.org/fhir/ValueSet/substance-code","bindingName":"SubstanceCode"},"index":3},"description":{"short":"Textual description of the substance, comments","type":"string","isSummary":true,"index":4},"instance":{"short":"If this describes a specific package/container of the substance","type":"BackboneElement","meaningWhenMissing":"If this element is not present, then the substance resource describes a kind of substance","isSummary":true,"array":true,"index":5,"elements":{"identifier":{"short":"Identifier of the package/container","type":"Identifier","isSummary":true,"index":6},"expiry":{"short":"When no longer valid to use","type":"dateTime","isSummary":true,"index":7},"quantity":{"short":"Amount of substance in the package","type":"Quantity","isSummary":true,"index":8}}},"ingredient":{"short":"Composition information about the substance","type":"BackboneElement","isSummary":true,"array":true,"index":9,"elements":{"quantity":{"short":"Optional amount (concentration)","type":"Ratio","isSummary":true,"index":10},"substance":{"short":"A component of the substance","isSummary":true,"choices":["substanceCodeableConcept","substanceReference"],"index":12},"substanceCodeableConcept":{"short":"A component of the substance","type":"CodeableConcept","isSummary":true,"choiceOf":"substance","index":13},"substanceReference":{"short":"A component of the substance","type":"Reference","isSummary":true,"choiceOf":"substance","refers":["http://hl7.org/fhir/StructureDefinition/Substance"],"index":14}},"required":["substance"]}},"required":["code"],"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceAmount","type":"SubstanceAmount","kind":"complex-type","class":"complex-type","url":"http://hl7.org/fhir/StructureDefinition/SubstanceAmount","version":"4.0.1","description":"Base StructureDefinition for SubstanceAmount Type: Chemical substances are a single substance type whose primary defining element is the molecular structure. Chemical substances shall be defined on the basis of their complete covalent molecular structure; the presence of a salt (counter-ion) and/or solvates (water, alcohols) is also captured. Purity, grade, physical form or particle size are not taken into account in the definition of a chemical substance or in the assignment of a Substance ID.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/BackboneElement","elements":{"amount":{"short":"Used to capture quantitative values for a variety of elements. If only limits are given, the arithmetic mean would be the average. If only a single definite value for a given element is given, it would be captured in this field","isSummary":true,"choices":["amountQuantity","amountRange","amountString"],"index":1},"amountQuantity":{"short":"Used to capture quantitative values for a variety of elements. If only limits are given, the arithmetic mean would be the average. If only a single definite value for a given element is given, it would be captured in this field","type":"Quantity","isSummary":true,"choiceOf":"amount","index":2},"amountRange":{"short":"Used to capture quantitative values for a variety of elements. If only limits are given, the arithmetic mean would be the average. If only a single definite value for a given element is given, it would be captured in this field","type":"Range","isSummary":true,"choiceOf":"amount","index":3},"amountString":{"short":"Used to capture quantitative values for a variety of elements. If only limits are given, the arithmetic mean would be the average. If only a single definite value for a given element is given, it would be captured in this field","type":"string","isSummary":true,"choiceOf":"amount","index":4},"amountType":{"short":"Most elements that require a quantitative value will also have a field called amount type. Amount type should always be specified because the actual value of the amount is often dependent on it. EXAMPLE: In capturing the actual relative amounts of substances or molecular fragments it is essential to indicate whether the amount refers to a mole ratio or weight ratio. For any given element an effort should be made to use same the amount type for all related definitional elements","type":"CodeableConcept","isSummary":true,"index":5},"amountText":{"short":"A textual comment on a numeric value","type":"string","isSummary":true,"index":6},"referenceRange":{"short":"Reference range of possible or expected values","type":"Element","isSummary":true,"index":7,"elements":{"lowLimit":{"short":"Lower limit possible or expected","type":"Quantity","isSummary":true,"index":8},"highLimit":{"short":"Upper limit possible or expected","type":"Quantity","isSummary":true,"index":9}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceNucleicAcid","type":"SubstanceNucleicAcid","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstanceNucleicAcid","version":"4.0.1","description":"Nucleic acids are defined by three distinct elements: the base, sugar and linkage. Individual substance/moiety IDs will be created for each of these elements. The nucleotide sequence will be always entered in the 5’-3’ direction.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"sequenceType":{"short":"The type of the sequence shall be specified based on a controlled vocabulary","type":"CodeableConcept","isSummary":true,"index":0},"numberOfSubunits":{"short":"The number of linear sequences of nucleotides linked through phosphodiester bonds shall be described. Subunits would be strands of nucleic acids that are tightly associated typically through Watson-Crick base pairing. NOTE: If not specified in the reference source, the assumption is that there is 1 subunit","type":"integer","isSummary":true,"index":1},"areaOfHybridisation":{"short":"The area of hybridisation shall be described if applicable for double stranded RNA or DNA. The number associated with the subunit followed by the number associated to the residue shall be specified in increasing order. The underscore “” shall be used as separator as follows: “Subunitnumber Residue”","type":"string","isSummary":true,"index":2},"oligoNucleotideType":{"short":"(TBC)","type":"CodeableConcept","isSummary":true,"index":3},"subunit":{"short":"Subunits are listed in order of decreasing length; sequences of the same length will be ordered by molecular weight; subunits that have identical sequences will be repeated multiple times","type":"BackboneElement","isSummary":true,"array":true,"index":4,"elements":{"subunit":{"short":"Index of linear sequences of nucleic acids in order of decreasing length. Sequences of the same length will be ordered by molecular weight. Subunits that have identical sequences will be repeated and have sequential subscripts","type":"integer","isSummary":true,"index":5},"sequence":{"short":"Actual nucleotide sequence notation from 5' to 3' end using standard single letter codes. In addition to the base sequence, sugar and type of phosphate or non-phosphate linkage should also be captured","type":"string","isSummary":true,"index":6},"length":{"short":"The length of the sequence shall be captured","type":"integer","isSummary":true,"index":7},"sequenceAttachment":{"short":"(TBC)","type":"Attachment","isSummary":true,"index":8},"fivePrime":{"short":"The nucleotide present at the 5’ terminal shall be specified based on a controlled vocabulary. Since the sequence is represented from the 5' to the 3' end, the 5’ prime nucleotide is the letter at the first position in the sequence. A separate representation would be redundant","type":"CodeableConcept","isSummary":true,"index":9},"threePrime":{"short":"The nucleotide present at the 3’ terminal shall be specified based on a controlled vocabulary. Since the sequence is represented from the 5' to the 3' end, the 5’ prime nucleotide is the letter at the last position in the sequence. A separate representation would be redundant","type":"CodeableConcept","isSummary":true,"index":10},"linkage":{"short":"The linkages between sugar residues will also be captured","type":"BackboneElement","isSummary":true,"array":true,"index":11,"elements":{"connectivity":{"short":"The entity that links the sugar residues together should also be captured for nearly all naturally occurring nucleic acid the linkage is a phosphate group. For many synthetic oligonucleotides phosphorothioate linkages are often seen. Linkage connectivity is assumed to be 3’-5’. If the linkage is either 3’-3’ or 5’-5’ this should be specified","type":"string","isSummary":true,"index":12},"identifier":{"short":"Each linkage will be registered as a fragment and have an ID","type":"Identifier","isSummary":true,"index":13},"name":{"short":"Each linkage will be registered as a fragment and have at least one name. A single name shall be assigned to each linkage","type":"string","isSummary":true,"index":14},"residueSite":{"short":"Residues shall be captured as described in 5.3.6.8.3","type":"string","isSummary":true,"index":15}}},"sugar":{"short":"5.3.6.8.1 Sugar ID (Mandatory)","type":"BackboneElement","isSummary":true,"array":true,"index":16,"elements":{"identifier":{"short":"The Substance ID of the sugar or sugar-like component that make up the nucleotide","type":"Identifier","isSummary":true,"index":17},"name":{"short":"The name of the sugar or sugar-like component that make up the nucleotide","type":"string","isSummary":true,"index":18},"residueSite":{"short":"The residues that contain a given sugar will be captured. The order of given residues will be captured in the 5‘-3‘direction consistent with the base sequences listed above","type":"string","isSummary":true,"index":19}}}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstancePolymer","type":"SubstancePolymer","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstancePolymer","version":"4.0.1","description":"Todo.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"class":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":0},"geometry":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":1},"copolymerConnectivity":{"short":"Todo","type":"CodeableConcept","isSummary":true,"array":true,"index":2},"modification":{"short":"Todo","type":"string","isSummary":true,"array":true,"index":3},"monomerSet":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":4,"elements":{"ratioType":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":5},"startingMaterial":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":6,"elements":{"material":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":7},"type":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":8},"isDefining":{"short":"Todo","type":"boolean","isSummary":true,"index":9},"amount":{"short":"Todo","type":"SubstanceAmount","isSummary":true,"index":10}}}}},"repeat":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":11,"elements":{"numberOfUnits":{"short":"Todo","type":"integer","isSummary":true,"index":12},"averageMolecularFormula":{"short":"Todo","type":"string","isSummary":true,"index":13},"repeatUnitAmountType":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":14},"repeatUnit":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":15,"elements":{"orientationOfPolymerisation":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":16},"repeatUnit":{"short":"Todo","type":"string","isSummary":true,"index":17},"amount":{"short":"Todo","type":"SubstanceAmount","isSummary":true,"index":18},"degreeOfPolymerisation":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":19,"elements":{"degree":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":20},"amount":{"short":"Todo","type":"SubstanceAmount","isSummary":true,"index":21}}},"structuralRepresentation":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":22,"elements":{"type":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":23},"representation":{"short":"Todo","type":"string","isSummary":true,"index":24},"attachment":{"short":"Todo","type":"Attachment","isSummary":true,"index":25}}}}}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceProtein","type":"SubstanceProtein","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstanceProtein","version":"4.0.1","description":"A SubstanceProtein is defined as a single unit of a linear amino acid sequence, or a combination of subunits that are either covalently linked or have a defined invariant stoichiometric relationship. This includes all synthetic, recombinant and purified SubstanceProteins of defined sequence, whether the use is therapeutic or prophylactic. This set of elements will be used to describe albumins, coagulation factors, cytokines, growth factors, peptide/SubstanceProtein hormones, enzymes, toxins, toxoids, recombinant vaccines, and immunomodulators.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"sequenceType":{"short":"The SubstanceProtein descriptive elements will only be used when a complete or partial amino acid sequence is available or derivable from a nucleic acid sequence","type":"CodeableConcept","isSummary":true,"index":0},"numberOfSubunits":{"short":"Number of linear sequences of amino acids linked through peptide bonds. The number of subunits constituting the SubstanceProtein shall be described. It is possible that the number of subunits can be variable","type":"integer","isSummary":true,"index":1},"disulfideLinkage":{"short":"The disulphide bond between two cysteine residues either on the same subunit or on two different subunits shall be described. The position of the disulfide bonds in the SubstanceProtein shall be listed in increasing order of subunit number and position within subunit followed by the abbreviation of the amino acids involved. The disulfide linkage positions shall actually contain the amino acid Cysteine at the respective positions","type":"string","isSummary":true,"array":true,"index":2},"subunit":{"short":"This subclause refers to the description of each subunit constituting the SubstanceProtein. A subunit is a linear sequence of amino acids linked through peptide bonds. The Subunit information shall be provided when the finished SubstanceProtein is a complex of multiple sequences; subunits are not used to delineate domains within a single sequence. Subunits are listed in order of decreasing length; sequences of the same length will be ordered by decreasing molecular weight; subunits that have identical sequences will be repeated multiple times","type":"BackboneElement","isSummary":true,"array":true,"index":3,"elements":{"subunit":{"short":"Index of primary sequences of amino acids linked through peptide bonds in order of decreasing length. Sequences of the same length will be ordered by molecular weight. Subunits that have identical sequences will be repeated and have sequential subscripts","type":"integer","isSummary":true,"index":4},"sequence":{"short":"The sequence information shall be provided enumerating the amino acids from N- to C-terminal end using standard single-letter amino acid codes. Uppercase shall be used for L-amino acids and lowercase for D-amino acids. Transcribed SubstanceProteins will always be described using the translated sequence; for synthetic peptide containing amino acids that are not represented with a single letter code an X should be used within the sequence. The modified amino acids will be distinguished by their position in the sequence","type":"string","isSummary":true,"index":5},"length":{"short":"Length of linear sequences of amino acids contained in the subunit","type":"integer","isSummary":true,"index":6},"sequenceAttachment":{"short":"The sequence information shall be provided enumerating the amino acids from N- to C-terminal end using standard single-letter amino acid codes. Uppercase shall be used for L-amino acids and lowercase for D-amino acids. Transcribed SubstanceProteins will always be described using the translated sequence; for synthetic peptide containing amino acids that are not represented with a single letter code an X should be used within the sequence. The modified amino acids will be distinguished by their position in the sequence","type":"Attachment","isSummary":true,"index":7},"nTerminalModificationId":{"short":"Unique identifier for molecular fragment modification based on the ISO 11238 Substance ID","type":"Identifier","isSummary":true,"index":8},"nTerminalModification":{"short":"The name of the fragment modified at the N-terminal of the SubstanceProtein shall be specified","type":"string","isSummary":true,"index":9},"cTerminalModificationId":{"short":"Unique identifier for molecular fragment modification based on the ISO 11238 Substance ID","type":"Identifier","isSummary":true,"index":10},"cTerminalModification":{"short":"The modification at the C-terminal shall be specified","type":"string","isSummary":true,"index":11}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceReferenceInformation","type":"SubstanceReferenceInformation","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstanceReferenceInformation","version":"4.0.1","description":"Todo.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"comment":{"short":"Todo","type":"string","isSummary":true,"index":0},"gene":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":1,"elements":{"geneSequenceOrigin":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":2},"gene":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":3},"source":{"short":"Todo","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":4}}},"geneElement":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":5,"elements":{"type":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":6},"element":{"short":"Todo","type":"Identifier","isSummary":true,"index":7},"source":{"short":"Todo","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":8}}},"classification":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":9,"elements":{"domain":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":10},"classification":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":11},"subtype":{"short":"Todo","type":"CodeableConcept","isSummary":true,"array":true,"index":12},"source":{"short":"Todo","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":13}}},"target":{"short":"Todo","type":"BackboneElement","isSummary":true,"array":true,"index":14,"elements":{"target":{"short":"Todo","type":"Identifier","isSummary":true,"index":15},"type":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":16},"interaction":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":17},"organism":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":18},"organismType":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":19},"amount":{"short":"Todo","isSummary":true,"choices":["amountQuantity","amountRange","amountString"],"index":21},"amountQuantity":{"short":"Todo","type":"Quantity","isSummary":true,"choiceOf":"amount","index":22},"amountRange":{"short":"Todo","type":"Range","isSummary":true,"choiceOf":"amount","index":23},"amountString":{"short":"Todo","type":"string","isSummary":true,"choiceOf":"amount","index":24},"amountType":{"short":"Todo","type":"CodeableConcept","isSummary":true,"index":25},"source":{"short":"Todo","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":26}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceSourceMaterial","type":"SubstanceSourceMaterial","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstanceSourceMaterial","version":"4.0.1","description":"Source material shall capture information on the taxonomic and anatomical origins as well as the fraction of a material that can result in or can be modified to form a substance. This set of data elements shall be used to define polymer substances isolated from biological matrices. Taxonomic and anatomical origins shall be described using a controlled vocabulary as required. This information is captured for naturally derived polymers ( . starch) and structurally diverse substances. For Organisms belonging to the Kingdom Plantae the Substance level defines the fresh material of a single species or infraspecies, the Herbal Drug and the Herbal preparation. For Herbal preparations, the fraction information will be captured at the Substance information level and additional information for herbal extracts will be captured at the Specified Substance Group 1 information level. See for further explanation the Substance Class: Structurally Diverse and the herbal annex.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"sourceMaterialClass":{"short":"General high level classification of the source material specific to the origin of the material","type":"CodeableConcept","isSummary":true,"index":0},"sourceMaterialType":{"short":"The type of the source material shall be specified based on a controlled vocabulary. For vaccines, this subclause refers to the class of infectious agent","type":"CodeableConcept","isSummary":true,"index":1},"sourceMaterialState":{"short":"The state of the source material when extracted","type":"CodeableConcept","isSummary":true,"index":2},"organismId":{"short":"The unique identifier associated with the source material parent organism shall be specified","type":"Identifier","isSummary":true,"index":3},"organismName":{"short":"The organism accepted Scientific name shall be provided based on the organism taxonomy","type":"string","isSummary":true,"index":4},"parentSubstanceId":{"short":"The parent of the herbal drug Ginkgo biloba, Leaf is the substance ID of the substance (fresh) of Ginkgo biloba L. or Ginkgo biloba L. (Whole plant)","type":"Identifier","isSummary":true,"array":true,"index":5},"parentSubstanceName":{"short":"The parent substance of the Herbal Drug, or Herbal preparation","type":"string","isSummary":true,"array":true,"index":6},"countryOfOrigin":{"short":"The country where the plant material is harvested or the countries where the plasma is sourced from as laid down in accordance with the Plasma Master File. For “Plasma-derived substances” the attribute country of origin provides information about the countries used for the manufacturing of the Cryopoor plama or Crioprecipitate","type":"CodeableConcept","isSummary":true,"array":true,"index":7},"geographicalLocation":{"short":"The place/region where the plant is harvested or the places/regions where the animal source material has its habitat","type":"string","isSummary":true,"array":true,"index":8},"developmentStage":{"short":"Stage of life for animals, plants, insects and microorganisms. This information shall be provided only when the substance is significantly different in these stages (e.g. foetal bovine serum)","type":"CodeableConcept","isSummary":true,"index":9},"fractionDescription":{"short":"Many complex materials are fractions of parts of plants, animals, or minerals. Fraction elements are often necessary to define both Substances and Specified Group 1 Substances. For substances derived from Plants, fraction information will be captured at the Substance information level ( . Oils, Juices and Exudates). Additional information for Extracts, such as extraction solvent composition, will be captured at the Specified Substance Group 1 information level. For plasma-derived products fraction information will be captured at the Substance and the Specified Substance Group 1 levels","type":"BackboneElement","isSummary":true,"array":true,"index":10,"elements":{"fraction":{"short":"This element is capturing information about the fraction of a plant part, or human plasma for fractionation","type":"string","isSummary":true,"index":11},"materialType":{"short":"The specific type of the material constituting the component. For Herbal preparations the particulars of the extracts (liquid/dry) is described in Specified Substance Group 1","type":"CodeableConcept","isSummary":true,"index":12}}},"organism":{"short":"This subclause describes the organism which the substance is derived from. For vaccines, the parent organism shall be specified based on these subclause elements. As an example, full taxonomy will be described for the Substance Name: ., Leaf","type":"BackboneElement","isSummary":true,"index":13,"elements":{"family":{"short":"The family of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":14},"genus":{"short":"The genus of an organism shall be specified; refers to the Latin epithet of the genus element of the plant/animal scientific name; it is present in names for genera, species and infraspecies","type":"CodeableConcept","isSummary":true,"index":15},"species":{"short":"The species of an organism shall be specified; refers to the Latin epithet of the species of the plant/animal; it is present in names for species and infraspecies","type":"CodeableConcept","isSummary":true,"index":16},"intraspecificType":{"short":"The Intraspecific type of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":17},"intraspecificDescription":{"short":"The intraspecific description of an organism shall be specified based on a controlled vocabulary. For Influenza Vaccine, the intraspecific description shall contain the syntax of the antigen in line with the WHO convention","type":"string","isSummary":true,"index":18},"author":{"short":"4.9.13.6.1 Author type (Conditional)","type":"BackboneElement","isSummary":true,"array":true,"index":19,"elements":{"authorType":{"short":"The type of author of an organism species shall be specified. The parenthetical author of an organism species refers to the first author who published the plant/animal name (of any rank). The primary author of an organism species refers to the first author(s), who validly published the plant/animal name","type":"CodeableConcept","isSummary":true,"index":20},"authorDescription":{"short":"The author of an organism species shall be specified. The author year of an organism shall also be specified when applicable; refers to the year in which the first author(s) published the infraspecific plant/animal name (of any rank)","type":"string","isSummary":true,"index":21}}},"hybrid":{"short":"4.9.13.8.1 Hybrid species maternal organism ID (Optional)","type":"BackboneElement","isSummary":true,"index":22,"elements":{"maternalOrganismId":{"short":"The identifier of the maternal species constituting the hybrid organism shall be specified based on a controlled vocabulary. For plants, the parents aren’t always known, and it is unlikely that it will be known which is maternal and which is paternal","type":"string","isSummary":true,"index":23},"maternalOrganismName":{"short":"The name of the maternal species constituting the hybrid organism shall be specified. For plants, the parents aren’t always known, and it is unlikely that it will be known which is maternal and which is paternal","type":"string","isSummary":true,"index":24},"paternalOrganismId":{"short":"The identifier of the paternal species constituting the hybrid organism shall be specified based on a controlled vocabulary","type":"string","isSummary":true,"index":25},"paternalOrganismName":{"short":"The name of the paternal species constituting the hybrid organism shall be specified","type":"string","isSummary":true,"index":26},"hybridType":{"short":"The hybrid type of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":27}}},"organismGeneral":{"short":"4.9.13.7.1 Kingdom (Conditional)","type":"BackboneElement","isSummary":true,"index":28,"elements":{"kingdom":{"short":"The kingdom of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":29},"phylum":{"short":"The phylum of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":30},"class":{"short":"The class of an organism shall be specified","type":"CodeableConcept","isSummary":true,"index":31},"order":{"short":"The order of an organism shall be specified,","type":"CodeableConcept","isSummary":true,"index":32}}}}},"partDescription":{"short":"To do","type":"BackboneElement","isSummary":true,"array":true,"index":33,"elements":{"part":{"short":"Entity of anatomical origin of source material within an organism","type":"CodeableConcept","isSummary":true,"index":34},"partLocation":{"short":"The detailed anatomic location when the part can be extracted from different anatomical locations of the organism. Multiple alternative locations may apply","type":"CodeableConcept","isSummary":true,"index":35}}}},"package_meta":{"name":"hl7.fhir.r4.core","version":"4.0.1"}}
{"name":"SubstanceSpecification","type":"SubstanceSpecification","kind":"resource","class":"resource","url":"http://hl7.org/fhir/StructureDefinition/SubstanceSpecification","version":"4.0.1","description":"The detailed description of a substance, typically at a level beyond what is used for prescribing.","derivation":"specialization","base":"http://hl7.org/fhir/StructureDefinition/DomainResource","elements":{"identifier":{"short":"Identifier by which this substance is known","type":"Identifier","isSummary":true,"index":0},"type":{"short":"High level categorization, e.g. polymer or nucleic acid","type":"CodeableConcept","isSummary":true,"index":1},"status":{"short":"Status of substance within the catalogue e.g. approved","type":"CodeableConcept","isSummary":true,"index":2},"domain":{"short":"If the substance applies to only human or veterinary use","type":"CodeableConcept","isSummary":true,"index":3},"description":{"short":"Textual description of the substance","type":"string","isSummary":true,"index":4},"source":{"short":"Supporting literature","type":"Reference","isSummary":true,"refers":["http://hl7.org/fhir/StructureDefinition/DocumentReference"],"array":true,"index":5},"comment":{"short":"Textual comment about this record of a substance","type":"string","isSummary":true,"index":6},"moiety":{"short":"Moiety, for structural modifications","type":"BackboneElement","isSummary":true,"array":true,"index":7,"elements":{"role":{"short":"Role that the moiety is playing","type":"CodeableConcept","isSummary":true,"index":8},"identifier":{"short":"Identifier by which this moiety substance is known","type":"Identifier","isSummary":true,"index":9},"name":{"short":"Textual name for this moiety substance","type":"string","isSummary":true,"index":10},"stereochemistry":{"short":"Stereochemistry type","type":"CodeableConcept","isSummary":true,"index":11},"opticalActivity":{"short":"Optical activity type","type":"CodeableConcept","isSummary":true,"index":12},"molecularFormula":{"sh