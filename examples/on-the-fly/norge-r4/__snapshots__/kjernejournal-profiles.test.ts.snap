    public setVerifier (value: KjVerifierProfile | Extension | Reference<"PractitionerRole" /* http://nhn.no/kj/fhir/StructureDefinition/KjPractitionerRole */>): this {
        if (value instanceof KjVerifierProfile) {
            upsertExtension(this.resource, value.toResource())
        } else if (isExtension(value)) {
            if (value.url !== "http://nhn.no/kj/fhir/StructureDefinition/KjVerifier") throw new Error(\`Expected extension url 'http://nhn.no/kj/fhir/StructureDefinition/KjVerifier', got '\${value.url}'\`)
            upsertExtension(this.resource, value)
        } else {
            upsertExtension(this.resource, KjVerifierProfile.createResource({ valueReference: value as Reference<"PractitionerRole" /* http://nhn.no/kj/fhir/StructureDefinition/KjPractitionerRole */> }))
        }
        return this
    }

    public getVerifier(mode: 'flat'): Reference | undefined;
    public getVerifier(mode: 'profile'): KjVerifierProfile | undefined;
    public getVerifier(mode: 'raw'): Extension | undefined;
    public getVerifier(): Reference | undefined;
    public getVerifier (mode: 'flat' | 'profile' | 'raw' = 'flat'): Reference | KjVerifierProfile | Extension | undefined {
        const ext = this.resource.extension?.find(e => e.url === "http://nhn.no/kj/fhir/StructureDefinition/KjVerifier")
        if (!ext) return undefined
        if (mode === 'raw') return ext
        if (mode === 'profile') return KjVerifierProfile.apply(ext)
        return getExtensionValue<Reference>(ext, "valueReference")
    }

    // Slices
    // Validation
    validate(): { errors: string[]; warnings: string[] } {
        const profileName = "KjProcedure"
        const res = this.resource
        return {
            errors: [
                ...validateRequired(res, profileName, "status"),
                ...validateEnum(res, profileName, "status", ["in-progress","entered-in-error","completed"]),
                ...validateRequired(res, profileName, "category"),
                ...validatePatternValue(res, profileName, "category", {"coding":[{"system":"http://nhn.no/kj/fhir/CodeSystem/SubcategoriesOfCriticalInformation"}]}),
                ...validateRequired(res, profileName, "code"),
                ...validatePatternValue(res, profileName, "code", {"coding":[{"system":"http://nhn.no/kj/fhir/CodeSystem/OngoingTreatment"}]}),
                ...validateRequired(res, profileName, "subject"),
                ...validateReference(res, profileName, "subject", ["Patient"]),
                ...validateChoiceProhibited(res, profileName, ["performedPeriod","performedString","performedRange"]),
                ...validateRequired(res, profileName, "recorder"),
                ...validateReference(res, profileName, "recorder", ["PractitionerRole"]),
            ],
            warnings: [
                ...validateMustSupport(res, profileName, "note"),
            ],
        }
    }

}

"
`;

