{
  "resourceType": "StructureDefinition",
  "id": "example-open-multi-type-observation",
  "url": "http://example.org/fhir/StructureDefinition/ExampleOpenMultiTypeObservation",
  "version": "0.0.1",
  "name": "ExampleOpenMultiTypeObservation",
  "title": "Example Open Multi-Type Observation",
  "status": "draft",
  "date": "2024-01-01",
  "publisher": "Atomic Example Studio",
  "description": "An Observation profile with explicit multi-type ceilings and open type slices.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Observation",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "slicing": {
          "discriminator": [
            {
              "type": "type",
              "path": "$this"
            }
          ],
          "rules": "open",
          "ordered": false
        },
        "type": [
          {
            "code": "dateTime"
          },
          {
            "code": "Period"
          }
        ]
      },
      {
        "id": "Observation.effective[x]:effectivePeriod",
        "path": "Observation.effective[x]",
        "sliceName": "effectivePeriod",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Period"
          }
        ]
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "slicing": {
          "discriminator": [
            {
              "type": "type",
              "path": "$this"
            }
          ],
          "rules": "open",
          "ordered": false
        },
        "type": [
          {
            "code": "Quantity"
          },
          {
            "code": "CodeableConcept"
          }
        ]
      },
      {
        "id": "Observation.value[x]:valueCodeableConcept",
        "path": "Observation.value[x]",
        "sliceName": "valueCodeableConcept",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ]
      }
    ]
  }
}
