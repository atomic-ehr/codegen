export type NotedPatient_NotedVFlat = Pick<NotedComplexExtensionProfileFlat, "note" | "detail">;

// CanonicalURL: http://example.test/StructureDefinition/noted-patient (pkg: example.folder.structures#0.0.1)
export class NotedPatientProfile {
    static readonly resourceType = "Patient";
    static readonly canonicalUrl = "http://example.test/StructureDefinition/noted-patient";

    private resource: Patient;

    constructor (resource: Patient) {
        this.resource = resource;
    }

    static from (resource: Patient) : NotedPatientProfile {
        if (!resource.meta?.profile?.includes(NotedPatientProfile.canonicalUrl)) {
            throw new Error(\`NotedPatientProfile: meta.profile must include \${NotedPatientProfile.canonicalUrl}\`)
        }
        const profile = new NotedPatientProfile(resource);
        const { errors } = profile.validate();
        if (errors.length > 0) throw new Error(errors.join("; "))
        return profile;
    }

    static is (resource: unknown) : resource is Patient {
        if (typeof resource !== "object" || resource === null) return false;
        const r = resource as { resourceType?: string; meta?: { profile?: string[] } };
        if (r.resourceType !== "Patient") return false;
        return (r.meta?.profile ?? []).includes(NotedPatientProfile.canonicalUrl);
    }

