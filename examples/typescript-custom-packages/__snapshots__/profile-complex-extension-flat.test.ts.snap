        return this.resource;
    }

    // Field accessors
    // Extensions
    public setNoted (input: NotedComplexExtensionProfileFlat | NotedComplexExtensionProfile | Extension): this {
        if (input instanceof NotedComplexExtensionProfile) {
            upsertExtension(this.resource, input.toResource())
        } else if (isExtension<Extension>(input)) {
            if (input.url !== "http://example.test/StructureDefinition/noted-complex-extension") throw new Error(\`Expected extension url 'http://example.test/StructureDefinition/noted-complex-extension', got '\${input.url}'\`)
            upsertExtension(this.resource, input)
        } else {
